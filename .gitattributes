# Normalize line endings: store LF in the repo, check out native on Windows.
# Without this, every file touched on this machine shows up as fully rewritten.
* text=auto

*.py   text
*.md   text
*.csv  text
*.log  text
*.txt  text
*.patch text eol=lf
*.sh   text eol=lf
*.bat  text eol=crlf

*.npy  binary
*.pth  binary
*.pkl  binary
*.png  binary
*.jpg  binary
*.pdf  binary
