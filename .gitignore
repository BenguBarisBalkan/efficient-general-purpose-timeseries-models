# Single source of truth for the whole workspace.
# Upstream TimeMixer shipped its own TimeMixer/.gitignore; it was folded into this
# file so one place governs every study in the repo. Inline (same-line) comments are
# NOT valid in .gitignore — git treats them as part of the pattern — so every note
# here sits on its own line.

# ── Python environment ────────────────────────────────────────────────────────
# 4.7 GB. Rebuild: python -m venv TimeMixer/venv && pip install -r TimeMixer/requirements.txt
TimeMixer/venv/
__pycache__/
*.py[cod]
.python-version

# ── Datasets ──────────────────────────────────────────────────────────────────
# 2.7 GB. ETT/Weather/ECL/M4/PEMS ship with upstream; PSM/SMD/UEA are fetched by
# TimeMixer/benchmarks/tools/fetch_task_datasets.py
dataset/

# ── Machine-generated run output ──────────────────────────────────────────────
# All of this is regenerated by run.py and far too large to track.
# ~7.4 GB — pred.npy / true.npy / metrics.npy, one dir per run setting
TimeMixer/results/
# ~270 MB — saved weights
TimeMixer/checkpoints/
# ~39 MB — per-run test output
TimeMixer/test_results/
# ~13 MB — M4 submission CSVs
TimeMixer/m4_results/
*.pth

# Auto-appended metric dumps; the same numbers are in logs/run_logs*/ per run.
TimeMixer/logs/result_*.txt

# TimeMixer/logs/ is otherwise deliberately TRACKED: the per-run logs are the
# evidence behind every table in TimeMixer/reports/, and the runners' skip /
# idempotency decision reads them.

# ── Local tooling ─────────────────────────────────────────────────────────────
.claude/settings.local.json

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_store
Thumbs.db
desktop.ini
